  m_Script: {fileID: 11500000, guid: fd333e05fc6655246b501ccbd8d989b4, type: 3}
  m_Name: StoryData_2preday
  m_EditorClassIdentifier: 
  Day: 1
  storyText:
  - contentText: TutttTutt (Suara notifikasi dari ponsel)
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: Mataku yang masih setengah terlelap tidur.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: Mencoba membuka ponsel ku yang berdering.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: 1400 Pesan Tertulis di grup Diskusi Azura Corp.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: TOLONG PERKETAT SYSTEM.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: Mulai Geledah seluruh barang penumpang.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: Mataku yang masih sayu sayu bangun tidur.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: Masih mencoba memahami seluruh isi pesan.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: Insiden Pembunuhan Pada Penerbangan Evakuasi003
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: 8 Korban jatuh meninggal ditempat.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: 20 Korban lainyya luka-luka.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: Dan Pelaku berhasil dilumpuhkan dan diintrogasi atas motif.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: WHHHHAT--
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: "Protokol Darurat: Waspadai senjata dan narkotika di koper penumpang"
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: "Harga Ticket Evakuasi Melambung Tinggi. 350$ ke 500$"
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: ....
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: Hari ku rasanya makin berat.. ak butuh 4 ticket.
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: Setidaknya 2000$
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
  - contentText: ....
    audioSource: {fileID: 8300000, guid: b90f18b2a3c26014587a8193551341a5, type: 3}
    textSpeed: 0.03
 

